{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/python.exe -m ruff*)",
      "Bash(.venv/Scripts/python.exe -m scripts.demo_*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm test*)",
      "Bash(npm run build*)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Edit(data/**)"
    ],
    "ask": [
      "Read(data/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe -m scripts.hook_validar_knowledge",
            "statusMessage": "Validando knowledge/",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
